# Local Postgres from docker-compose.yml (code falls back to this URL when unset)
DATABASE_URL=postgres://mbti:mbti@localhost:5433/mbti

# Better Auth (Identity). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
# Google OAuth client (Google Cloud console). Authorized redirect URI:
# http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
