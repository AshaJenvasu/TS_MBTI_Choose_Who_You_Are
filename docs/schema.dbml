enum compatibility_kind {
  compatible
  challenging
}

table character {
  id integer [pk, not null]
  mbti_type text [not null]
  name text [not null]
  image_url text [not null]
  description text [not null]

  indexes {
    mbti_type [name: 'character_mbti_type_unique', unique]
  }
}

table mbti_type_compatibility {
  type_code text [not null]
  other_type text [not null]
  kind compatibility_kind [not null]

  indexes {
    (type_code, other_type) [pk]
    
  }
}

table mbti_type_info {
  type_code text [pk, not null]
  golden_pair_type text [not null]
  house text [not null]
}

table test_result {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id text
  guest_token uuid [unique]
  mbti_type text [not null]
  matched_character_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  ei_score integer [not null]
  sn_score integer [not null]
  tf_score integer [not null]
  jp_score integer [not null]
}

table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    user_id [name: 'account_userId_idx']
    (provider_id, account_id) [name: 'account_provider_account_unique', unique]
  }
}

table session {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]

  indexes {
    user_id [name: 'session_userId_idx']
  }
}

table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

ref character_mbti_type_mbti_type_info_type_code_fk: character.mbti_type > mbti_type_info.type_code [delete: no action, update: no action]

ref mbti_type_compatibility_type_code_mbti_type_info_type_code_fk: mbti_type_compatibility.type_code > mbti_type_info.type_code [delete: no action, update: no action]

ref mbti_type_compatibility_other_type_mbti_type_info_type_code_fk: mbti_type_compatibility.other_type > mbti_type_info.type_code [delete: no action, update: no action]

ref mbti_type_info_golden_pair_type_fk: mbti_type_info.golden_pair_type > mbti_type_info.type_code [delete: no action, update: no action]

ref test_result_user_id_user_id_fk: test_result.user_id > user.id [delete: restrict, update: no action]

ref test_result_mbti_type_mbti_type_info_type_code_fk: test_result.mbti_type > mbti_type_info.type_code [delete: no action, update: no action]

ref test_result_matched_character_id_character_id_fk: test_result.matched_character_id > character.id [delete: no action, update: no action]

ref account_user_id_user_id_fk: account.user_id > user.id [delete: cascade, update: no action]

ref session_user_id_user_id_fk: session.user_id > user.id [delete: cascade, update: no action]